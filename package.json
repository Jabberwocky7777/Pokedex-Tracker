{
  "name": "pok-dex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && npm test --prefix sync-server",
    "preview": "vite preview",
    "generate-data": "tsx --tsconfig tsconfig.scripts.json scripts/fetch-data.ts && npm run validate-data",
    "generate-moves": "tsx --tsconfig tsconfig.scripts.json scripts/moves-data.ts",
    "validate-data": "tsx --tsconfig tsconfig.scripts.json scripts/validate-data.ts",
    "generate-save-tables": "tsx --tsconfig tsconfig.scripts.json scripts/fetch-save-tables.ts",
    "fetch-battle-tower": "tsx --tsconfig tsconfig.scripts.json scripts/fetch-battle-tower.ts",
    "ios:sync": "npx cap sync ios",
    "ios:icons": "npx capacitor-assets generate --ios",
    "generate:icon": "node scripts/generate-icon.mjs",
    "e2e": "npm run build && tsx --tsconfig tsconfig.scripts.json scripts/e2e-links.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.12"
  }
}
