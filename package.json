{
  "name": "pokedex-tracker",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && npm test --prefix sync-server",
    "preview": "vite preview",
    "generate-data": "tsx --tsconfig scripts/tsconfig.json scripts/fetch-data.ts && npm run validate-data",
    "generate-moves": "tsx --tsconfig scripts/tsconfig.json scripts/moves-data.ts",
    "validate-data": "tsx --tsconfig scripts/tsconfig.json scripts/validate-data.ts",
    "generate-save-tables": "tsx --tsconfig scripts/tsconfig.json scripts/fetch-save-tables.ts",
    "unlock-gaps": "tsx --tsconfig scripts/tsconfig.json scripts/unlock-gaps.ts",
    "fetch-battle-tower": "tsx --tsconfig scripts/tsconfig.json scripts/fetch-battle-tower.ts",
    "fetch-xp-data": "tsx --tsconfig scripts/tsconfig.json scripts/fetch-xp-data.ts",
    "ios:sync": "npx cap sync ios",
    "generate:icon": "node scripts/generate-icon.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "generate:social": "node scripts/generate-social-preview.mjs",
    "e2e": "npm run build && tsx --tsconfig scripts/tsconfig.json scripts/e2e-links.ts",
    "screenshots": "npm run build && tsx --tsconfig scripts/tsconfig.json scripts/capture-screenshots.ts",
    "knip": "knip --include files,dependencies,unlisted,exports,duplicates",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json",
    "version:set": "node scripts/release.mjs set",
    "version:check": "node scripts/release.mjs check",
    "release:notes": "node scripts/release.mjs notes"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
