# Copy this file to .env and set your values.
# All three variables are required for login and sync to work.

# Username and password for the in-app login screen.
APP_USER=replace-with-your-username
APP_PASSWORD=replace-with-a-strong-password

# Sync API token — internal secret used to authenticate sync requests.
# Never shown to the user; returned by the server after successful login.
# Generate with: openssl rand -hex 32
SYNC_TOKEN=replace-with-your-secret-token

# (Optional) Extra origins allowed to call the sync API from another site,
# comma-separated, e.g. http://192.168.1.50:5173
# The app is served from the same origin as the API and needs nothing here.
# Left blank, only the Vite dev server (http://localhost:5173) and the iOS app
# (capacitor://localhost) are allowed.
CORS_ORIGIN=

# (Optional) Reverse proxies whose X-Forwarded-For header is trusted to name the
# real client, comma-separated addresses or CIDR ranges — e.g. 172.16.0.0/12 or
# 192.168.1.10. The rate limits count per client, so this matters behind a proxy.
# Left blank: loopback and the private ranges (10/8, 172.16/12, 192.168/16).
# "none" trusts nothing.
TRUSTED_PROXIES=
