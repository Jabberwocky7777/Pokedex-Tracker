# ── Node dependencies ──────────────────────────────────────────────────────────
# Reinstalled fresh inside the Docker build stage via `npm ci`.
# Excluding this prevents sending hundreds of MB over the build context socket.
node_modules

# ── Build output ───────────────────────────────────────────────────────────────
# Generated during Docker build — we don't want a stale local build sneaking in.
dist
dist-ssr

# ── Environment files ──────────────────────────────────────────────────────────
.env
.env.*
*.local

# ── Version control ────────────────────────────────────────────────────────────
.git
.gitignore

# ── Editor and IDE ─────────────────────────────────────────────────────────────
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS metadata ────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Windows-specific local launchers ───────────────────────────────────────────
*.exe
*.vbs
launcher/

# ── Claude Code session files ──────────────────────────────────────────────────
.claude/

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── TypeScript build cache ─────────────────────────────────────────────────────
node_modules/.tmp

# ── Not needed to build the image ──────────────────────────────────────────────
# The iOS project and IPAs, docs and screenshots, and the CI/GitHub files
ios/
ipa-download/
*.ipa
docs/
.github/

# ── Personal data — never sent to the Docker daemon ────────────────────────────
# Game saves (including the real-save test fixtures) and local exports
*.sav
*.dsv
src/lib/save/__tests__/fixtures/
notes-and-print-deliverables/
ux-review-screenshots/
